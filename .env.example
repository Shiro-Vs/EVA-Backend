# Copiar a .env (ignorado por git). Estas variables se validan al arrancar: si falta una, el proceso no inicia.

PORT=3000
LOG_LEVEL=info
TZ_DEFAULT=America/Lima

# Clúster local del proyecto (npm run db:init). Solo escucha en 127.0.0.1 y no usa contraseña.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/eva_dev
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/eva_test

# Autenticación. En local se firman JWT con un secreto de desarrollo (AUTH_MODE=dev).
# En staging/producción: AUTH_MODE=jwks y AUTH_JWKS_URL / AUTH_ISSUER del proyecto Supabase.
AUTH_MODE=dev
AUTH_DEV_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres
AUTH_JWKS_URL=
AUTH_ISSUER=

# Firma de los tokens de vista previa (13 §1.2). En local se reutiliza AUTH_DEV_SECRET si se omite.
PREVIEW_SECRET=

# Clientes web de desarrollo permitidos (CORS), separados por coma. Ejemplo para Expo web:
# CORS_ORIGINS=http://localhost:8090,http://localhost:8081
CORS_ORIGINS=

# Solo desarrollo: habilita POST /dev/login (entrar sin pegar token). Usa el id de `npm run dev:token` para conservar tus datos.
DEV_LOGIN_USER_ID=

# Captura asistida (Entrega 4). EXTRACTOR=none | heuristic (solo texto simple, desarrollo) | gemini.
# La clave de Gemini vive SOLO aquí (servidor); nunca en variables EXPO_PUBLIC_*. El modelo se elige con la documentación vigente de Google.
EXTRACTOR=none
GEMINI_API_KEY=
GEMINI_MODEL=
# Archivos originales (almacenamiento privado en disco para desarrollo).
STORAGE_DIR=.storage
# Correo entrante: secreto compartido con el proveedor de correo (mínimo 16 caracteres). Vacío = la ruta /webhooks/email no existe.
INBOUND_SECRET=
INBOX_DOMAIN=eva.local
CAPTURE_DAILY_LIMIT=30
CAPTURE_MAX_MB=12
