// EVA-backend — schema.prisma
// Diseño completo documentado en: D:\Proyectos\EVA\docs (ver plan de diseño de BDD aprobado)
// Convención: modelos/campos en camelCase (Prisma/TS), @map/@@map a snake_case en la BD real.
// Todos los montos son Decimal(14,2) — nunca Float — para evitar errores de redondeo en dinero.

datasource db {
  provider = "sqlite" // cambia a "postgresql" en producción (Railway); mismo schema, mismo código TS.
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum AccountType {
  DEBIT
  CREDIT
  DIGITAL_WALLET
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVING_CONTRIBUTION
  LOAN_PAYMENT
  TRANSFER
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum LoanInstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum SubscriptionFrequency {
  MONTHLY
  ANNUAL
}

enum DebtSourceType {
  INFORMAL
  SUBSCRIPTION_SHARE
}

enum PendingTransactionStatus {
  PENDING
  APPROVED
  DISCARDED
}

// ============================================================
// USER
// ============================================================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  displayName      String   @map("display_name")
  passwordHash     String?  @map("password_hash")
  googleId         String?  @unique @map("google_id")
  inboxEmail       String?  @unique @map("inbox_email")
  mainCurrency     String   @default("PEN") @map("main_currency")
  avatarUrl        String?  @map("avatar_url")
  aiAutoCategorize Boolean  @default(true) @map("ai_auto_categorize")
  aiVoiceAssistant Boolean  @default(false) @map("ai_voice_assistant")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accounts            Account[]
  categories          Category[]
  budgets             Budget[]
  goals               Goal[]
  contacts            Contact[]
  loans               Loan[]
  subscriptions       Subscription[]
  transactions        Transaction[]
  transfers           Transfer[]
  debts               Debt[]
  pendingTransactions PendingTransaction[]
  auditLogs           AuditLog[]

  @@map("users")
}

// ============================================================
// ACCOUNTS (con jerarquía padre/subcuenta)
// ============================================================

model Account {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentAccountId String?     @map("parent_account_id")
  parentAccount   Account?    @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childAccounts   Account[]   @relation("AccountHierarchy")

  name             String
  type             AccountType
  currentBalance   Decimal     @default(0) @db.Decimal(14, 2) @map("current_balance")
  creditLimit      Decimal?    @db.Decimal(14, 2) @map("credit_limit")
  statementDay     Int?        @map("statement_day")
  paymentDueDay    Int?        @map("payment_due_day")
  color            String
  icon             String
  isDefault        Boolean     @default(false) @map("is_default")
  excludeFromTotal Boolean     @default(false) @map("exclude_from_total")
  deletedAt        DateTime?   @map("deleted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  transactions        Transaction[]
  transfersOut        Transfer[]          @relation("TransferFrom")
  transfersIn         Transfer[]          @relation("TransferTo")
  subscriptionsPaidBy Subscription[]
  subscriptionCycles  SubscriptionCycle[]

  @@index([userId])
  @@index([userId, isDefault])
  @@index([parentAccountId])
  @@map("accounts")
}

// ============================================================
// CATEGORIES + BUDGET (histórico mes a mes)
// ============================================================

model Category {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name          String
  icon          String
  color         String
  defaultBudget Decimal?  @db.Decimal(14, 2) @map("default_budget")
  createdByAi   Boolean   @default(false) @map("created_by_ai")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  transactions       Transaction[]
  transactionDetails TransactionDetail[]
  budgets            Budget[]

  @@index([userId])
  @@map("categories")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, year, month])
  @@index([userId, year, month])
  @@map("budgets")
}

// ============================================================
// GOALS
// ============================================================

model Goal {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name          String
  targetAmount  Decimal      @db.Decimal(14, 2) @map("target_amount")
  currentAmount Decimal      @default(0) @db.Decimal(14, 2) @map("current_amount")
  deadline      DateTime
  priority      GoalPriority @default(MEDIUM)
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  contributions Transaction[]

  @@index([userId])
  @@map("goals")
}

// ============================================================
// TRANSACTIONS (ledger con monto firmado) + TRANSFERS
// ============================================================

model Transaction {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accountId         String           @map("account_id")
  account           Account          @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId        String?          @map("category_id")
  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  goalId            String?          @map("goal_id")
  goal              Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  loanInstallmentId String?          @map("loan_installment_id")
  loanInstallment   LoanInstallment? @relation(fields: [loanInstallmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transferId        String?          @map("transfer_id")
  transfer          Transfer?        @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type         TransactionType
  amount       Decimal   @db.Decimal(14, 2) // firmado: negativo = sale de accountId, positivo = entra
  description  String
  occurredAt   DateTime  @map("occurred_at")
  hasBreakdown Boolean   @default(false) @map("has_breakdown")
  receiptUrl   String?   @map("receipt_url")
  rawAiInput   String?   @map("raw_ai_input")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  details      TransactionDetail[]
  debtItems    DebtItem[]
  debtPayments DebtPayment[]

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId])
  @@index([transferId])
  @@map("transactions")
}

model TransactionDetail {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId    String      @map("category_id")
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount        Decimal     @db.Decimal(14, 2)
  itemName      String      @map("item_name")

  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_details")
}

model Transfer {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fromAccountId String    @map("from_account_id")
  fromAccount   Account   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toAccountId   String    @map("to_account_id")
  toAccount     Account   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount        Decimal   @db.Decimal(14, 2)
  feeAmount     Decimal?  @db.Decimal(14, 2) @map("fee_amount")
  description   String?
  occurredAt    DateTime  @map("occurred_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  legs Transaction[]

  @@index([userId, occurredAt])
  @@map("transfers")
}

// ============================================================
// LOANS (deuda bancaria/institucional — NO ligada a Contact)
// ============================================================

model Loan {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entityName        String    @map("entity_name")
  principalAmount   Decimal   @db.Decimal(14, 2) @map("principal_amount")
  totalInstallments Int       @map("total_installments")
  interestRate      Decimal   @db.Decimal(6, 4) @map("interest_rate")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  installments LoanInstallment[]

  @@index([userId])
  @@map("loans")
}

model LoanInstallment {
  id                String                @id @default(uuid())
  loanId            String                @map("loan_id")
  loan              Loan                  @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  installmentNumber Int                   @map("installment_number")
  amount            Decimal               @db.Decimal(14, 2)
  dueDate           DateTime              @map("due_date")
  status            LoanInstallmentStatus @default(PENDING)
  accruedLateFee    Decimal               @default(0) @db.Decimal(14, 2) @map("accrued_late_fee")
  paidAt            DateTime?             @map("paid_at")

  payments Transaction[]

  @@unique([loanId, installmentNumber])
  @@index([loanId, status])
  @@map("loan_installments")
}

// ============================================================
// SUBSCRIPTIONS (servicios compartidos)
// ============================================================

model Subscription {
  id               String                @id @default(uuid())
  userId           String                @map("user_id")
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  paymentAccountId String                @map("payment_account_id")
  paymentAccount   Account               @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name             String
  currentCost      Decimal               @db.Decimal(14, 2) @map("current_cost")
  billingDay       Int                   @map("billing_day")
  frequency        SubscriptionFrequency @default(MONTHLY)
  isShared         Boolean               @default(false) @map("is_shared")
  startDate        DateTime              @map("start_date")
  color            String?
  icon             String?
  deletedAt        DateTime?             @map("deleted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  cycles       SubscriptionCycle[]
  participants SubscriptionMember[]
  debts        Debt[]

  @@index([userId])
  @@index([paymentAccountId])
  @@map("subscriptions")
}

model SubscriptionMember {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactId      String       @map("contact_id")
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fixedQuota     Decimal      @db.Decimal(14, 2) @map("fixed_quota")
  isCourtesy     Boolean      @default(false) @map("is_courtesy")
  paidUntil      DateTime?    @map("paid_until")
  joinedAt       DateTime     @map("joined_at")
  leftAt         DateTime?    @map("left_at") // soft-remove: conserva historial en cycle payments

  cyclePayments SubscriptionCyclePayment[]

  @@unique([subscriptionId, contactId])
  @@index([contactId])
  @@map("subscription_members")
}

model SubscriptionCycle {
  id               String                @id @default(uuid())
  subscriptionId   String                @map("subscription_id")
  subscription     Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  year             Int
  month            Int
  costAtTime       Decimal               @db.Decimal(14, 2) @map("cost_at_time")
  expectedDueDate  DateTime              @map("expected_due_date")
  actualPaidAt     DateTime?             @map("actual_paid_at")
  daysLate         Int                   @default(0) @map("days_late")
  wasSharedAtTime  Boolean               @map("was_shared_at_time")
  frequencyAtTime  SubscriptionFrequency @map("frequency_at_time")
  paymentAccountId String?               @map("payment_account_id")
  paymentAccount   Account?              @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bankAmountPaid   Decimal?              @db.Decimal(14, 2) @map("bank_amount_paid")

  payments SubscriptionCyclePayment[]

  @@unique([subscriptionId, year, month])
  @@index([subscriptionId, expectedDueDate])
  @@map("subscription_cycles")
}

// Cargo mensual de un participante — el "originador" del DebtItem correspondiente.
model SubscriptionCyclePayment {
  id                   String             @id @default(uuid())
  cycleId              String             @map("cycle_id")
  cycle                SubscriptionCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subscriptionMemberId String             @map("subscription_member_id")
  subscriptionMember   SubscriptionMember @relation(fields: [subscriptionMemberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quotaAtTime          Decimal            @db.Decimal(14, 2) @map("quota_at_time")
  debtItemId           String?            @unique @map("debt_item_id")
  debtItem             DebtItem?          @relation(fields: [debtItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([cycleId, subscriptionMemberId])
  @@map("subscription_cycle_payments")
}

// ============================================================
// CONTACTS
// ============================================================

model Contact {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String
  color     String
  phone     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  debts               Debt[]
  subscriptionMembers SubscriptionMember[]

  @@index([userId])
  @@map("contacts")
}

// ============================================================
// DEUDAS P2P — Debt (agregado por contacto) + DebtItem/DebtPayment/DebtAllocation
// ============================================================

// Un saldo agregado por (contacto, origen). Para deuda informal hay UNO por contacto
// (sourceType=INFORMAL, subscriptionId=null); para servicios compartidos hay uno por
// (contacto, suscripción) (sourceType=SUBSCRIPTION_SHARE). La unicidad del caso INFORMAL
// (subscriptionId nulo) se garantiza a nivel de aplicación con un find-or-create, ya que
// SQL estándar no colisiona NULLs en un índice único compuesto.
model Debt {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactId      String         @map("contact_id")
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceType     DebtSourceType @map("source_type")
  subscriptionId String?        @map("subscription_id")
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currentBalance Decimal        @default(0) @db.Decimal(14, 2) @map("current_balance") // cache; SUM(items.remaining) es la verdad
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  items    DebtItem[]
  payments DebtPayment[]

  @@index([userId, contactId])
  @@index([subscriptionId])
  @@map("debts")
}

// Un concepto/cargo individual dentro de una Debt (ej. "Préstamo moto", "Almuerzo",
// o la cuota mensual de un servicio compartido). remainingAmount se decrementa
// con cada DebtAllocation aplicada.
model DebtItem {
  id                    String       @id @default(uuid())
  debtId                String       @map("debt_id")
  debt                  Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  concept               String
  originalAmount        Decimal      @db.Decimal(14, 2) @map("original_amount")
  remainingAmount       Decimal      @db.Decimal(14, 2) @map("remaining_amount")
  occurredAt            DateTime     @map("occurred_at")
  note                  String?
  relatedTransactionId  String?      @map("related_transaction_id") // si el préstamo salió realmente de una cuenta propia
  relatedTransaction    Transaction? @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt             DateTime     @default(now()) @map("created_at")

  allocations              DebtAllocation[]
  subscriptionCyclePayment SubscriptionCyclePayment?

  @@index([debtId, occurredAt])
  @@map("debt_items")
}

// Un abono/pago del contacto, repartible entre uno o varios DebtItem vía DebtAllocation.
model DebtPayment {
  id                   String       @id @default(uuid())
  debtId               String       @map("debt_id")
  debt                 Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount               Decimal      @db.Decimal(14, 2)
  occurredAt           DateTime     @map("occurred_at")
  note                 String?
  relatedTransactionId String?      @map("related_transaction_id") // si el dinero entró realmente a una cuenta propia
  relatedTransaction   Transaction? @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt            DateTime     @default(now()) @map("created_at")

  allocations DebtAllocation[]

  @@index([debtId, occurredAt])
  @@map("debt_payments")
}

// Reparte un DebtPayment entre uno o varios DebtItem (o un DebtItem entre varios pagos).
model DebtAllocation {
  id            String      @id @default(uuid())
  paymentId     String      @map("payment_id")
  payment       DebtPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  itemId        String      @map("item_id")
  item          DebtItem    @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amountApplied Decimal     @db.Decimal(14, 2) @map("amount_applied")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([paymentId, itemId])
  @@index([itemId])
  @@map("debt_allocations")
}

// ============================================================
// PENDING TRANSACTIONS (buzón inteligente)
// ============================================================

model PendingTransaction {
  id                  String                   @id @default(uuid())
  userId              String                   @map("user_id")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  suggestedAccountId  String?                  @map("suggested_account_id")
  suggestedCategoryId String?                  @map("suggested_category_id")
  amount              Decimal                  @db.Decimal(14, 2)
  type                TransactionType
  counterparty        String
  sourceChannel       String                   @map("source_channel") // "Yape", "Plin", "BCP", etc.
  status              PendingTransactionStatus @default(PENDING)
  rawEmailPayload     String?                  @map("raw_email_payload")
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("pending_transactions")
}

// ============================================================
// AUDITORÍA (aplicada a todas las entidades vía middleware/extension de Prisma)
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String   // "CREATE" | "UPDATE" | "DELETE" | "SOFT_DELETE"
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
